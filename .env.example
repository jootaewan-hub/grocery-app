# 값은 서버 함수 환경변수에만 넣는다. 이 파일에는 이름만 둔다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
FOODSAFETY_API_KEY=
ANTHROPIC_API_KEY=

# Supabase 주소와 공개용 키는 src/lib/supabaseConfig.ts에 있어서 .env 없이 실행된다.
# 다른 Supabase 프로젝트로 시험할 때만 .env.local에 VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY를 넣어 덮어쓴다.
